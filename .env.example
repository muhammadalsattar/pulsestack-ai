# Optional: Connect Next.js API routes to the FastAPI backend.
# Leave unset to run the built-in in-app multi-tenant demo engine (ideal for standalone Vercel deploys).
FASTAPI_URL=http://localhost:8003

# Optional: Enable live OpenAI streaming for gpt-4o-mini in the FastAPI gateway.
# Without this key, the gateway streams deterministic responses with full token & cost metering.
OPENAI_API_KEY=

# Optional: Enable live Stripe Checkout sessions for plan upgrades.
# Without this key, Billing runs an interactive Demo Checkout + simulated webhook flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS & redirect origin
CORS_ORIGINS=http://localhost:3003
FRONTEND_URL=http://localhost:3003
